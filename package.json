{
  "name": "kitchen-blockcards",
  "version": "0.1.0",
  "private": true,
  "description": "Kitchen Blockcards \u2014 mobile-first kitchen notebook: meal counts, prep lists, rotating menus, recipes.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "build:static": "GITHUB_PAGES=true next build && node scripts/write-precache.mjs out",
    "test:e2e:static": "E2E_STATIC=1 playwright test --trace off"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
